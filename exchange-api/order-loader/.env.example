# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# `POST /keys` shows the secret exactly once. The key is bound to the host you
# created it on and is invalid on any other.
#
# Nothing here is required for a dry run: with no credentials the loader reads
# public market data, validates your file against the venue's trading rules, and
# prints what it would send. Credentials are needed for `--submit`, and for
# reading your rate-limit budgets (that endpoint is authenticated, though it
# costs no tokens).

# API key id, e.g. nx_...
NEXUS_EXCHANGE_API_KEY=

# API secret paired with the key above — hex, shown once at creation.
NEXUS_EXCHANGE_API_SECRET=

# REST base URL. Defaults to the durable testnet base below. The `/indexer`
# prefix is part of it: the bare host answers 404 on every path. The app appends
# the full `/api/v1/...` path itself, so do NOT include `/api/v1` here.
# NEXUS_EXCHANGE_API_URL=https://api.testnet.nexus.xyz/indexer

# What the target's balances are made of: play | real | unknown.
# Only needed when pointing at a host this example does not recognise. It
# defaults to `unknown` for such a host, and `unknown` is treated exactly like
# `real`: submission is refused. Declaring `play` is you taking responsibility.
# NEXUS_EXCHANGE_FUNDS=play

# The order file, relative to this directory unless absolute.
# NEXUS_ORDER_FILE=orders.example.json

# Orders per POST /orders/batch call. Default 39 — see the README on why that is
# one less than you would expect. Capped at 40.
# NEXUS_BATCH_CHUNK=39

# Which orders are worth a preview: none | first-per-market | all.
# A preview is charged to the trading bucket exactly as a placement is, so
# `all` halves your effective placement rate.
# NEXUS_PREVIEW_POLICY=first-per-market

# Refuse a file larger than this. A blast-radius cap, not a limit of the API.
# NEXUS_MAX_ORDERS=200

# Fraction of each rate-limit budget this app will spend, leaving the rest for
# anything else using the same key. In (0, 1].
# NEXUS_BUDGET_UTILISATION=0.8

# Allow a time_in_force that can take liquidity (GTC / IOC / FOK). Off by
# default: the loader places PostOnly orders, which the venue refuses if they
# would cross.
# NEXUS_ALLOW_TAKER=0

# Idempotency prefix for this run. Defaults to random, so two runs never collide.
# Set it to a fixed value and re-running the same file places nothing new — the
# venue answers each repeated client_id with the order it already holds.
# NEXUS_RUN_ID=
