# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# `POST /keys` shows the secret exactly once. The key is bound to the host you
# created it on and is invalid on any other.
#
# Nothing here is required for the read-only dashboard: with no credentials the
# app polls public market data over REST. Credentials unlock the WebSocket
# (its upgrade token comes from a signed call) and `--trade`.

# API key id, e.g. nx_...
NEXUS_EXCHANGE_API_KEY=

# API secret paired with the key above — hex, shown once at creation.
NEXUS_EXCHANGE_API_SECRET=

# REST base URL. Defaults to the live testnet base below; the app appends the
# full `/api/v1/...` path itself, so do NOT include `/api/v1` here. The
# `/indexer` prefix IS required — the bare host 404s.
# NEXUS_EXCHANGE_API_URL=https://api.testnet.nexus.xyz/indexer

# WebSocket endpoint. Leave unset and the app polls REST instead — it will not
# guess an origin. Testnet serves one, so this is the value to use; it needs
# credentials, because the upgrade token comes from a signed call.
# NEXUS_EXCHANGE_WS_URL=wss://api.testnet.nexus.xyz/indexer/ws

# What the target's balances are made of: play | real | unknown.
# Only needed when pointing at a host this example does not recognise. It
# defaults to `unknown` for such a host, and `unknown` is treated exactly like
# `real`: trading is refused. Declaring `play` is you taking responsibility.
# NEXUS_EXCHANGE_FUNDS=play

# Market to trade. Any id from GET /api/v1/markets/summary.
# NEXUS_MARKET=BTC-USDX-PERP

# How far below the mid the `--trade` order rests, in basis points (100 = 1%).
# Larger is safer: the order is meant to rest, not to fill.
# NEXUS_ORDER_DISTANCE_BPS=200

# Order size. Defaults to the market's minimum, which is what you want here.
# NEXUS_ORDER_QUANTITY=
