# Copy this file to `.env` only if you want to change a default. Nothing here is
# required, and nothing here is a credential: this example reads public market
# data only, over an unauthenticated WebSocket and unauthenticated REST routes.

# REST base URL. Defaults to the live testnet base below. The app appends the
# route itself, so do NOT include `/api/v1` here. The `/indexer` prefix IS
# required — the bare host 404s.
# NEXUS_EXCHANGE_API_URL=https://api.testnet.nexus.xyz/indexer

# Public market-data WebSocket. Defaults to the REST base with `wss://` and
# `/stream` appended, which is where testnet serves it.
# NEXUS_EXCHANGE_STREAM_URL=wss://api.testnet.nexus.xyz/indexer/stream

# Market to replicate. Any id from GET /markets/summary.
# NEXUS_MARKET=BTC-USDX-PERP

# Seconds between cross-checks of the replica against a REST snapshot.
# NEXUS_CROSSCHECK_SECONDS=15
