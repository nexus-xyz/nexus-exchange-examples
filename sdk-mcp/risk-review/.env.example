# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# This example runs against testnet — play funds, never real ones.

# Required. This review reads your account, so it cannot run on public data.
# These are forwarded to the MCP server subprocess and nothing else is: the
# server's environment is built explicitly rather than inherited from yours.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional. Points the MCP server at another deployment (a local stack).
# Setting it selects the server's `custom` network.
NEXUS_EXCHANGE_API_URL=

# ── Limits ──────────────────────────────────────────────────────────────────
# Set at least one, or the review refuses to start: a review with no limits
# would print reassuring output while checking nothing.
#
# All are exact decimals, quoted in USDX, and must be greater than zero.

# Cap on total position notional across all markets.
NEXUS_GUARD_MAX_NOTIONAL=1000

# Cap on total unrealized loss, as a positive number. `50` means "flag once
# unrealized PnL is worse than -50".
NEXUS_GUARD_MAX_LOSS=50

# Floor on available margin. Flags when available margin drops below this.
NEXUS_GUARD_MIN_AVAILABLE_MARGIN=
