# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# This file is *parsed*, not sourced: `KEY=VALUE` lines only, one optional layer
# of quotes stripped, nothing expanded and nothing executed. A real environment
# variable always wins over a value here, so `LADDER_RUNGS=5 ./run.sh` works.

# ─── credentials (optional) ─────────────────────────────────────────────────
# Without these the app runs read-only: it prints the ladder it *would* keep,
# using public market data only. With them it can read your open orders and
# account, and --commit can place and cancel.
#
# Mint a testnet key pair with `nexus keys create` (see the CLI's README), or run
# `nexus setup` and let the CLI store them — this app reads whichever it finds.
#
# NOTE the names. The CLI reads NEXUS_API_KEY / NEXUS_API_SECRET. The Nexus
# *SDKs* — and the other examples in this catalog — read NEXUS_EXCHANGE_API_KEY /
# NEXUS_EXCHANGE_API_SECRET. Copying a `.env` over from one of those examples
# leaves this one unauthenticated, and the only symptom is that it quietly runs
# read-only.
NEXUS_API_KEY=
NEXUS_API_SECRET=

# ─── what to quote ──────────────────────────────────────────────────────────
# Market to quote on. Must be listed by `nexus markets`.
LADDER_MARKET=BTC-USDX-PERP

# buy | sell | both. `buy` by default: a bid-only ladder can only ever open a
# long, and one side is enough to see the whole mechanism.
LADDER_SIDES=buy

# How many rungs per side (1-20), how far the first one sits from the mark price,
# and how far apart the rest are. 100bps = 1%.
LADDER_RUNGS=3
LADDER_START_BPS=100
LADDER_STEP_BPS=50

# Size of each rung, in base units. Empty means the market's own minimum order
# size, which is the smallest thing the venue will accept.
LADDER_QUANTITY=

# ─── how it behaves ─────────────────────────────────────────────────────────
# The client-order-id prefix that marks an order as this app's. Everything it
# cancels, it cancels by id under this prefix — so orders you placed by hand are
# never touched, and two ladders on one account need two different tags.
LADDER_TAG=ql

# Which network. testnet (play funds) or local. `mainnet` is refused outright,
# with no override.
LADDER_NETWORK=testnet

# Where the run lock lives. One directory per ladder you intend to run
# concurrently; the default is `.state/` beside the script.
# LADDER_STATE_DIR=

# Per-CLI-call timeout in seconds, and how many times a *read* may be retried.
# Writes are never retried, whatever this says.
LADDER_TIMEOUT_SECONDS=30
LADDER_READ_ATTEMPTS=3

# Escape hatches, both off by default:
#   LADDER_ALLOW_CLI_VERSION=1   run even if the CLI is not the pinned release
#   LADDER_ALLOW_NETWORK=<label> permit a custom network you declared yourself
#                                (never `mainnet`)
