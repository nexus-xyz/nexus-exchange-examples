# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# This file is *parsed*, not sourced: `KEY=VALUE` lines only, one optional
# layer of quotes stripped, nothing expanded and nothing executed. A real
# environment variable always wins over a value here, so
# `MONITOR_CHANNELS=fills ./run.sh` works.

# ─── credentials (required) ─────────────────────────────────────────────────
# Per-account channels are scoped to the wallet that minted the WebSocket
# token, so there is no read-only mode here: without credentials the monitor
# would attach, ack every subscription, and report nothing — which looks
# exactly like a quiet account. It refuses to start instead.
#
# Mint a testnet key pair with `nexus keys create` (see the CLI's README), or
# run `nexus setup` and let the CLI store them.
#
# NOTE the names. The CLI reads NEXUS_API_KEY / NEXUS_API_SECRET. The Nexus
# *SDKs* — and most of the other examples in this catalog — read
# NEXUS_EXCHANGE_API_KEY / NEXUS_EXCHANGE_API_SECRET. Copying a `.env` over
# from one of those examples leaves this one unauthenticated.
NEXUS_API_KEY=
NEXUS_API_SECRET=

# ─── where to connect ───────────────────────────────────────────────────────
# The durable testnet deployment. The `/indexer` prefix is load-bearing: the
# bare host answers 404 on every route.
#
# These are not passed to the CLI as a `--base-url` override. The app writes a
# throwaway CLI config declaring them as a custom network — see the README's
# "Why this does not just say --network testnet".
MONITOR_BASE_URL=https://api.testnet.nexus.xyz/indexer

# The WebSocket origin. `/ws`, not `/stream`: `/stream` is the legacy
# public-only endpoint and carries no per-account channels and no sequence
# numbers, so there is nothing on it to resume from.
#
# No query string. The single-use token is appended as `?token=…` at connect
# time.
MONITOR_WS_URL=wss://api.testnet.nexus.xyz/indexer/ws

# The label the generated CLI config files this deployment under. It also
# namespaces the CLI's stored credentials, so change it only if you run two
# monitors against two deployments.
MONITOR_NETWORK_LABEL=nexus-testnet-indexer

# ─── what to follow ─────────────────────────────────────────────────────────
# Space-separated per-account channels: orders, fills, positions, balances,
# liquidations. One supervised `nexus ws` process per channel, because
# `--since` is single-valued and each channel's sequence is its own.
#
# `liquidations` is worth adding deliberately rather than by default: its
# alerts are edge-triggered and have no REST equivalent, so a transition
# missed during an outage cannot be recovered at all. The app says so when it
# happens.
MONITOR_CHANNELS=orders fills positions balances

# Where the cursor store lives. This is the thing that makes the monitor
# resumable across a restart — delete it and the next run starts from the live
# edge. Defaults to `.state/` beside the script.
# MONITOR_STATE_DIR=

# ─── how it behaves ─────────────────────────────────────────────────────────
# Stop conditions, all off by default so `--follow` runs until you stop it.
# `--prove-resume` sets its own bounds if you leave these at 0.
MONITOR_RUN_SECONDS=0
MONITOR_MAX_EVENTS=0
MONITOR_MAX_ATTEMPTS=0

# How long to wait for the subscribe ack before calling an attach failed, and
# how long a silent-but-open socket is tolerated before reattaching from the
# cursor. The second is a liveness guard, not a correctness one: a per-account
# channel can legitimately be silent for hours, and nothing is lost by
# reattaching, because the reattach replays whatever arrived in between. Set
# it to 0 to disable.
MONITOR_HANDSHAKE_SECONDS=30
MONITOR_IDLE_SECONDS=300

# Reconnect backoff, doubling up to the cap. Not zero by default: a monitor
# that reconnects in a tight loop against a venue refusing it hits the per-IP
# upgrade cap and then cannot reconnect when the venue recovers.
MONITOR_BACKOFF_SECONDS=1
MONITOR_BACKOFF_MAX_SECONDS=30

# `--prove-resume` only: how many events to take before severing the socket.
MONITOR_PROVE_AFTER=3

# Escape hatch, off by default:
#   MONITOR_ALLOW_CLI_VERSION=1   run even if the CLI is not the pinned release
MONITOR_ALLOW_CLI_VERSION=0
