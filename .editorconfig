# Baseline whitespace rules so examples in different languages stay consistent
# without every example shipping its own editor config.
# Docs: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust and Python both conventionally use 4 spaces (rustfmt / PEP 8).
[*.{rs,py}]
indent_size = 4

[*.{go,mk}]
indent_style = tab

[Makefile]
indent_style = tab

# Trailing whitespace is significant in Markdown (hard line break).
[*.md]
trim_trailing_whitespace = false
