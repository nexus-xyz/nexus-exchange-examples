# Copy this file to `.env` and fill in your own values, then export them.
# `cargo run` does not read `.env` itself, so use a loader such as `direnv`, or
# `set -a; . ./.env; set +a` in your shell. `.env` is gitignored. Never commit
# real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# This example runs against testnet (play funds, never real ones).

# Needed only for `--live`. The default dry run reads public market data and
# places nothing, so it runs with both of these blank.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional, and only together. They override the REST base and the WebSocket
# origin. Both must point at the same deployment, because the WebSocket token
# is minted over REST and only works on the origin that issued it.
# Defaults: https://api.testnet.nexus.xyz/indexer and
# wss://api.testnet.nexus.xyz/indexer/ws. Do not end the REST base in /api/v1.
# An override is labelled "funds not declared" in the banner, because a bare
# URL cannot say what it moves.
NEXUS_EXCHANGE_API_URL=
NEXUS_EXCHANGE_WS_URL=

# ── Probe ───────────────────────────────────────────────────────────────────
# Out-of-range values are refused, never clamped.

# Market to probe. Default BTC-USDX-PERP.
NEXUS_PROBE_MARKET=

# Round trips (one place and one cancel each), 1–200. Default 30.
NEXUS_PROBE_ITERATIONS=

# Minimum gap between round trips in ms, 250–60000. Default 1000. The app
# stretches the gap further, never shortens it, so that it uses at most 25% of
# your account's rate-limit budget.
NEXUS_PROBE_INTERVAL_MS=

# How long to wait for each WebSocket frame before recording the stage as
# missing, in ms, 500–30000. Default 3000.
NEXUS_PROBE_WS_WAIT_MS=

# How far below the mark to rest the order, in bps, 50–5000. Default: 80% of
# the market's live price_band_bps. It must be under the band, or the venue
# rejects the order, and the app checks this before placing.
NEXUS_PROBE_OFFSET_BPS=
