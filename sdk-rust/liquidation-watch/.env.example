# Copy this file to `.env` and fill in your own values, then export them —
# `cargo run` does not read `.env` itself, so use a loader such as `direnv`, or
# `set -a; . ./.env; set +a` in your shell. `.env` is gitignored; never commit
# real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# This example runs against testnet — play funds, never real ones. It is
# read-only: every call it makes is a GET.

# Required, both of them. Two of the four reads are HMAC-gated server-side:
# `/account/state` (your positions) and `/markets/{id}/adl-events` (the
# venue's ADL record), so there is no useful credential-free mode here.
# The app prints these back only as a shape — "set (64 characters, hex)" —
# never as a value and never as a prefix.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional. Overrides the REST base URL — point it at a local stack or a preview
# deployment. Validated at startup, so a typo fails there rather than at the
# first request.
#
# The default is the SDK's own `Network::Testnet`, whose base in 0.12.0 is
# https://api.testnet.nexus.xyz/v1. The `/v1` prefix is load-bearing: the bare
# host answers 404. Do NOT end an override in `/api/v1`: the SDK appends the
# spec's bare paths (`/account/state`) itself, and the app refuses a base ending
# that way.
#
# An explicit URL is treated as `Funds::Unknown`, because a bare URL cannot
# declare what the target moves, and the banner says "funds not declared"
# instead of claiming play funds.
NEXUS_EXCHANGE_API_URL=

# Optional. Your own 0x account address, which unlocks the account-scoped ADL
# history (`GET /account/{address}/adl-history`) — every ADL event where you
# were the bankrupt target or a closed counterparty.
#
# It has to be supplied because the API surface the SDK wraps has no "who am I"
# read: nothing on /account, /account/summary or /account/state carries the
# address, so the app skips this section rather than guessing.
NEXUS_ACCOUNT_ADDRESS=

# Optional. How many ADL events to pull per market and for the account.
# Between 1 and 1000 (the server's maximum); default 20.
NEXUS_ADL_LIMIT=20
