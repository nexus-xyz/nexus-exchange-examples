# Copy this file to `.env` and fill in your own values, then export them —
# `python enroll.py` does not read `.env` itself, so use a loader such as
# `direnv`, or `set -a; . ./.env; set +a` in your shell. `.env` is gitignored;
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# This example runs against testnet — play funds, never real ones.

# ── The wallet doing the delegating ─────────────────────────────────────────
# Required, including under --dry-run: this is the key that signs the EIP-712
# registration, and signing is what a dry run exists to show.
#
# It is used **locally only**. It never leaves this process, is never sent to the
# venue, and is never printed — not even in an error message. That is the whole
# point of an agent key: the bot you hand the agent key to never sees this.
#
# A testnet wallet, and only a testnet wallet. Generate a throwaway one for this
# rather than pasting a key you use anywhere else.
NEXUS_WALLET_PRIVATE_KEY=

# ── API credentials ─────────────────────────────────────────────────────────
# Required unless you pass --dry-run. `GET /agents` and `DELETE /agents/{address}`
# are signed calls, so listing and revoking need them.
#
# `POST /agents/register` does not: it is unauthenticated, and the EIP-712
# signature in its body is the credential.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# The agent's own key. Leave blank and one is generated from the OS CSPRNG for
# the run — which is what you want for a demonstration, since this example
# revokes what it registers before it exits.
#
# Set it to watch a key you actually intend to give a bot go through the same
# lifecycle. It must be a *different* key from the wallet above; delegating a
# wallet to itself is refused.
NEXUS_AGENT_PRIVATE_KEY=

# How long the delegation lasts, in whole days. Minimum 1, maximum 90, default 1.
# The venue accepts an expiry in [now+1d, now+90d], so 1 is the shortest real
# delegation there is — and the default, deliberately. See "Why the expiry is the
# point" in the README.
NEXUS_AGENT_TTL_DAYS=1

# Human-readable label, echoed back by `GET /agents`. 1–64 characters of ASCII
# letters, digits, '.', '_' or '-'. Default: agent-enrollment-example.
NEXUS_AGENT_LABEL=

# Points this example at another deployment — a local stack, a preview host. The
# same base is used for `GET /metadata` and for every request, so the signing
# domain always comes from the host the registration is sent to.
#
# An overridden target reports funds as `unknown`, because a bare URL cannot
# declare whose money is behind it, and the first line of output says so rather
# than claiming play funds.
NEXUS_EXCHANGE_API_URL=
