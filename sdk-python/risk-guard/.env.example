# Copy this file to `.env` and fill in your own values, then export them —
# `python guard.py` does not read `.env` itself, so use a loader such as
# `direnv`, or `set -a; . ./.env; set +a` in your shell. `.env` is gitignored;
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# This example runs against testnet — play funds, never real ones.

# Required. This app watches your account, so it cannot run on public data.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional. Points the client at another deployment — a local stack, a preview
# host. Pass the deployment base (e.g. https://<host>/api/exchange); the SDK
# appends /api/v1 itself, so do not include it here.
#
# An overridden target reports funds as `unknown`, because a bare URL cannot
# declare whose money is behind it, and the app's first line says so rather than
# claiming play funds. See "Which deployment it talks to" in the README — getting
# this wrong is easier than it looks.
NEXUS_EXCHANGE_API_URL=

# ── Limits ──────────────────────────────────────────────────────────────────
# Set at least one, or the guard refuses to start: a guard with no limits would
# print reassuring output forever while checking nothing.
#
# All are exact decimals, quoted in USDX, and must be greater than zero.

# Cap on total position notional across all markets.
NEXUS_GUARD_MAX_NOTIONAL=1000

# Cap on total unrealized loss, as a positive number. `50` means "fire once
# unrealized PnL is worse than -50".
NEXUS_GUARD_MAX_LOSS=50

# Floor on available margin. Fires when available margin drops below this.
NEXUS_GUARD_MIN_AVAILABLE_MARGIN=

# How often to poll, in whole seconds. Minimum 2, maximum 3600, default 15.
# Exponent, hex and underscore forms (`1e5`, `0x1e`, `1_0`) are refused rather
# than guessed at, the same as the limits above.
NEXUS_GUARD_INTERVAL_SECONDS=15
