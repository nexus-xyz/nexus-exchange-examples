# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# Never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# A key belongs to the host that minted it and is invalid anywhere else.
#
# This example runs against testnet (play funds, never real ones). With
# --live it places real IOC orders there.

# Optional for the dry run, required for --live. Without them the dry run
# reads the public order book only: GET /markets is signed, so the lot and
# minimum size go unchecked, and the rate-limit budgets can't be read.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional. The REST deployment base. Defaults to the SDK's testnet base,
# https://api.testnet.nexus.xyz/v1. Requests go to the spec's bare paths under
# it (/orders), so do not end it in /api/v1: the SDK refuses that old layout.
NEXUS_EXCHANGE_API_URL=

# Only for an overridden host: declare what its balances are. An override is
# treated as funds "unknown", and --live refuses "unknown". Setting this to
# `play` is you taking responsibility for that host being a testnet.
# NEXUS_EXCHANGE_FUNDS=play

# Fraction of each rate-limit budget this app will spend, leaving the rest for
# anything else using the same key. In (0, 1]. Default 0.5.
# NEXUS_TWAP_UTILISATION=0.5
