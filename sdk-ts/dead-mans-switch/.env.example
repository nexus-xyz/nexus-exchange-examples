# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# This example runs against testnet — play funds, never real ones. With --live
# it places one real order there and changes one account-wide setting.

# Required, both of them. This app reads and changes your account's
# cancel-on-disconnect setting, so it cannot run on public data.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional. The REST deployment base. Defaults to the durable testnet host,
# https://api.testnet.nexus.xyz/indexer — note the /indexer prefix, which is
# part of the deployment and not decoration: the bare host 404s.
#
# This is the deployment *base*; the SDK adds the /api/v1 prefix itself, so do
# not include it here (a base that carries it is refused with a message naming
# the value it wanted).
#
# An overridden target is treated as funds="unknown", because a bare URL cannot
# declare whose money is behind it, and the app's first line says so.
NEXUS_EXCHANGE_API_URL=

# Optional. The WebSocket base, prefix included. Defaults to the REST base with
# the scheme swapped, which is what you want in almost every case — the ws token
# is minted on the REST host and must be spent on the same one.
#
# Set it only for a deployment that really serves its stream from another
# origin. The app appends /ws itself.
NEXUS_EXCHANGE_WS_URL=

# ── The demonstration ───────────────────────────────────────────────────────

# Which market the one resting order goes on. Default BTC-USDX-PERP.
NEXUS_DMS_MARKET=BTC-USDX-PERP

# How far below the mark the order rests, in basis points (1 bp = 0.01%).
# Default 400.
#
# Bounded on both sides by things that are not preferences. Too close and the
# order can fill during the run, leaving you a position this example never
# offered to open. Too far and the engine's price band refuses it at admission —
# the band is the market's `price_band_bps` (500 on the testnet perps today) and
# the app checks your value against the live one before placing anything.
NEXUS_DMS_PRICE_OFFSET_BPS=400

# How long to keep watching past the venue's own grace window before declaring
# the demonstration failed, in whole seconds: minimum 5, maximum 600, default 30.
#
# Slack for everything the grace window does not cover — the indexer noticing
# the socket closed, the cancel reaching the engine, this app's next poll.
# Generous on purpose: giving up early and cancelling the order ourselves
# destroys the evidence.
NEXUS_DMS_WATCH_SLACK_SECONDS=30
