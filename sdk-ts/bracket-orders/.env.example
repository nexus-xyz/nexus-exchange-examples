# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# Never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# A key belongs to the host that minted it and is invalid anywhere else.
#
# This example runs against testnet (play funds, never real ones). With --live
# it places a real bracket there: an IOC entry and two reduce-only exits.

# Optional for the dry run, required for --live. Without them the dry run reads
# public data only: GET /markets is signed, so tick, lot and minimum size go
# unchecked, and cancel-on-disconnect, the position and open orders are unread.
NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=

# Optional. The REST deployment base. Defaults to the durable testnet host,
# https://api.testnet.nexus.xyz/indexer. The /indexer prefix is part of the
# deployment: the bare host 404s. Do not include /api/v1; the SDK adds it.
NEXUS_EXCHANGE_API_URL=

# Optional. The WebSocket base; `/ws` is appended. Defaults to the REST base
# with the scheme swapped, keeping its path: wss://api.testnet.nexus.xyz/indexer.
NEXUS_EXCHANGE_WS_URL=

# Only for an overridden host: declare what its balances are. An override is
# treated as funds "unknown", and --live refuses "unknown". Setting this to
# `play` is you taking responsibility for that host being a testnet.
# NEXUS_EXCHANGE_FUNDS=play

# How often the manager re-reads REST when the socket is quiet, in whole
# seconds, 2-300. Default 15. Frames and reconnects trigger a read immediately;
# this is the safety net for a socket that is silently dead.
# NEXUS_BRACKET_RECONCILE_SECONDS=15
