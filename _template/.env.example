# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# Examples run against testnet — play funds, never real ones.

# API key. Leave blank to run public market-data-only paths, where the example
# supports it.
NEXUS_EXCHANGE_API_KEY=

# API secret paired with the key above — 32-byte hex, shown once at creation.
NEXUS_EXCHANGE_API_SECRET=

# API base URL, e.g. https://<host>/api/v1 — overrides the SDK's default host.
# Set this if the SDK's built-in default doesn't point at a reachable API.
NEXUS_EXCHANGE_API_URL=
