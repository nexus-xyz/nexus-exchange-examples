# Copy this file to `.env` if you want to change anything. `.env` is
# gitignored.
#
# **This example needs no credentials.** Every endpoint it reads is public
# market data, and it runs with an empty environment — that is the point of it.
# There is nothing here to fill in; everything below is optional tuning.

# REST base URL. Defaults to the durable testnet base below. The `/indexer`
# prefix is part of it: the bare host answers 404 on every path. The app
# appends the full `/api/v1/...` path itself, so do NOT include `/api/v1` here.
# NEXUS_EXCHANGE_API_URL=https://api.testnet.nexus.xyz/indexer

# What the target's balances are made of: play | real | unknown.
# Only needed when pointing at a host this example does not recognise. It is
# reported in the header, never used to gate anything: this app is read-only
# and has no write path at all.
# NEXUS_EXCHANGE_FUNDS=play

# Look-back for the statistics, in hours. Defaults to 168 (7 days), which is
# very nearly the whole of what the funding endpoint holds — measured, it
# returns 173-174 settled windows spanning 7.2 days. Overridden by
# `--window-hours`.
# NEXUS_CARRY_WINDOW_HOURS=168

# Minimum settled windows before a market is ranked rather than listed.
# Defaults to 30. Below that the error bar on a dispersion estimate is wider
# than the differences a ranking would be claiming to resolve — see the README.
# Overridden by `--min-samples`.
# NEXUS_CARRY_MIN_SAMPLES=30

# What to sort by: ratio | carry | margin. Defaults to `ratio`, which is carry
# per unit of its own variability. Overridden by `--by`.
# NEXUS_CARRY_SORT=ratio

# Restrict the ranking to one market, e.g. BTC-USDX-PERP. Default is every
# market either list surface returns. Overridden by `--market`.
# NEXUS_MARKET=

# Fraction of the read budget this app will spend, leaving the rest for
# anything else on the same client IP. In (0, 1].
# NEXUS_BUDGET_UTILISATION=0.8
