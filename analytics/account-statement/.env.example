# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials, not even testnet ones.
#
# Create testnet API credentials in the Exchange app: https://exchange.nexus.xyz
# `POST /keys` shows the secret exactly once. The key is bound to the host you
# created it on and is invalid on any other.
#
# Unlike most examples in this catalog, this one needs credentials to do
# anything at all: every endpoint it reads is your own account's history, and
# all of them are authenticated. There is no public fallback worth having — the
# unauthenticated demo mirror serves empty history buffers, so a statement
# built from it would be a page of zeroes that looked like an answer.

# API key id, e.g. nx_...
NEXUS_EXCHANGE_API_KEY=

# API secret paired with the key above — hex, shown once at creation.
NEXUS_EXCHANGE_API_SECRET=

# REST base URL. Defaults to the durable testnet base below. The `/indexer`
# prefix is part of it: the bare host answers 404 on every path. The app
# appends the full `/api/v1/...` path itself, so do NOT include `/api/v1` here.
# NEXUS_EXCHANGE_API_URL=https://api.testnet.nexus.xyz/indexer

# What the target's balances are made of: play | real | unknown.
# Only needed when pointing at a host this example does not recognise. It is
# reported in the statement header, never used to gate anything: this app is
# read-only and cannot move a balance of either kind.
# NEXUS_EXCHANGE_FUNDS=play

# Statement period: day | week | month | all. Also the `window` sent to
# /account/portfolio-history, which fixes the server-side sample cadence AND
# the point capacity — see the README. Overridden by `--window`.
# NEXUS_STATEMENT_WINDOW=day

# Restrict the statement to one market, e.g. BTC-USDX-PERP. Default is every
# market the period touched. Overridden by `--market`.
# NEXUS_MARKET=

# Ceiling on rows pulled from each paginated surface. A politeness cap on your
# own budget, not a limit of the API. When a walk stops here the statement says
# so and calls its totals a floor rather than a total.
# NEXUS_MAX_ROWS=1000

# Fraction of the read budget this app will spend, leaving the rest for
# anything else using the same key. In (0, 1].
# NEXUS_BUDGET_UTILISATION=0.8
